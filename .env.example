# Copy to `.env.local` for real provider mode.
# When secrets are missing, the BFF runs in MOCK_BFF mode automatically.

# MOCK_BFF=1
# VIDEO_API_CLIENT_ID=
# VIDEO_API_SECRET=
# VIDEO_API_BASE_URL=https://your-video-api.example
# HLS_KEY_ALLOWED_ORIGINS=https://cdn.example,https://livestreaming.example
# CORS_ORIGINS=http://localhost:5173,http://localhost:4200
